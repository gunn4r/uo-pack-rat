{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "app/dist",
    "rootDir": "app",
    "types": [],
    "lib": ["esnext", "dom", "dom.iterable"]
  },
  "include": [
    "app/ui/**/*",
    "app/api/**/*",
    "app/vault-lib.*",
    "app/domain/rules.*",
    "app/domain/properties.*",
    "app/item-query.*",
    "app/unravel.*",
    "app/organize-config.*",
    "app/profile-edits.*",
    "app/scan-schema.*",
    "app/paste-scan.*",
    "app/buffs.*",
    "app/evaluate.*",
    "app/run-settings.*",
    "app/build-spec.*",
    "app/swing.*",
    "app/solver/scoring.*",
    "app/house-areas.*",
    "app/guards.*",
    "app/data-dir-notice.*",
    "app/schema/validate.*",
    "app/schema/types.d.mts"
  ],
  "exclude": ["node_modules", "app/dist", "**/*.test.mjs", "**/*.test.mts"]
}
