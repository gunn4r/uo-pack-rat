{
  "adapter": "razor-enhanced",
  "version": "1.12.0",
  "transport": "folder",
  "protocol": 1,
  "platform": "win32",
  "actions": ["open-container", "move-to-own-backpack", "pathfind-local", "client-local-highlight"],
  "capabilities": {
    "layers": ["RightHand", "LeftHand", "Shoes", "Pants", "Shirt", "Head", "Gloves", "Ring",
      "Talisman", "Neck", "Waist", "InnerTorso", "Bracelet", "MiddleTorso", "Earrings", "Arms",
      "Cloak", "OuterTorso", "OuterLegs", "InnerLegs"],
    "arms": true,
    "bank": true,
    "ground": true,
    "nested": true,
    "tooltips": "opl",
    "bridge": ["highlight", "grab", "goto"]
  },
  "install": {
    "scriptsSuffix": [["ClassicUO", "Data", "Plugins", "Razor", "Scripts"], ["Razor", "Scripts"], ["Scripts"]],
    "retired": [{ "name": "packrat-refresh.py", "header": "# packrat-refresh.py -- ATTENDED one-shot: QUICK character refresh for the Pack Rat app without a" }],
    "stopHint": "stop it in Razor Enhanced's Scripting tab (select it and press Stop), then retry",
    "register": "none"
  }
}
