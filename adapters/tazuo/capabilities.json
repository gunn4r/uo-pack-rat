{
  "adapter": "tazuo",
  "version": "2.16.0",
  "transport": "folder",
  "protocol": 1,
  "actions": ["open-container", "move-to-own-backpack", "move-into-ground-container", "pathfind-local", "client-local-highlight"],
  "capabilities": {
    "layers": ["OneHanded", "TwoHanded", "Shoes", "Pants", "Shirt", "Helmet", "Gloves",
      "Ring", "Talisman", "Necklace", "Waist", "Torso", "Bracelet", "Tunic",
      "Earrings", "Arms", "Cloak", "Robe", "Skirt", "Legs"],
    "arms": true,
    "bank": true,
    "ground": true,
    "nested": true,
    "tooltips": "opl",
    "bridge": ["highlight", "grab", "goto", "trip", "trip-bags"]
  },
  "install": {
    "scriptsSuffix": [["TazUO", "LegionScripts"], ["LegionScripts"]],
    "candidateRoot": "TazUO",
    "retired": [{ "name": "packrat-refresh.py", "header": "# packrat-refresh.py — ATTENDED one-shot: QUICK character refresh for the Pack Rat" }],
    "stopHint": "type -stopall in game, wait for \"No scripts are currently running\", then retry",
    "register": "none"
  }
}
