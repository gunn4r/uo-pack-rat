{
  "name": "pack-rat",
  "version": "0.3.0",
  "description": "Every item you own, every suit you could wear. Inventory and suit builder for Ultima Online players.",
  "productName": "Pack Rat",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "electron/main.mts",
  "repository": {
    "type": "git",
    "url": "https://github.com/gunn4r/uo-pack-rat.git"
  },
  "homepage": "https://github.com/gunn4r/uo-pack-rat",
  "bugs": {
    "url": "https://github.com/gunn4r/uo-pack-rat/issues"
  },
  "author": "gunn4r",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:types": "node scripts/build-schema-types.mts",
    "build:ui": "node scripts/build-ui.mts",
    "gen:contracts": "node scripts/gen-contracts.mts",
    "gen:test-index": "node scripts/test-index.mts --write",
    "gen:modules": "node scripts/module-index.mts --write",
    "pretypecheck": "npm run build:types",
    "typecheck": "tsc -p tsconfig.json",
    "predesktop": "npm run build:types && npm run build:ui",
    "predist": "npm run build:types && npm run build:ui",
    "predist:dir": "npm run build:types && npm run build:ui",
    "start": "node scripts/start.mts",
    "desktop": "electron .",
    "try": "bash scripts/try-pr.sh",
    "dist": "electron-builder --publish never",
    "dist:dir": "electron-builder --dir --publish never",
    "test": "node scripts/test-runner.mts",
    "test:smoke": "node scripts/test-runner.mts --smoke",
    "test:fast": "node scripts/test-runner.mts --fast",
    "readme:shots": "node scripts/readme-shots.mts",
    "site:shots": "node scripts/site-shots.mts",
    "site:build": "node scripts/site-build.mts"
  },
  "dependencies": {
    "highs": "1.15.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "24.19.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "global-agent": "4.1.3",
    "http-cache-semantics": "4.3.0"
  },
  "build": {
    "appId": "com.gunn4r.packrat",
    "productName": "Pack Rat",
    "copyright": "Copyright © 2026 gunn4r",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**",
      "adapters/**",
      "electron/**",
      "scripts/optimizer-core.mts",
      "package.json",
      "LICENSE",
      "tsconfig.browser.json",
      "!**/*.test.mjs",
      "!**/*.test.mts",
      "!local/**",
      "!test_logs/**",
      "!docs/**",
      "!app/bench/**",
      "!**/__pycache__/**",
      "!adapters/**/test_*.py",
      "!adapters/fake_clients.py",
      "!adapters/**/fixture.scan.json",
      "!adapters/_shared/**",
      "!app/data/profiles.json",
      "!app/data/runs/**",
      "!app/ui/**/*.mts"
    ],
    "asar": true,
    "asarUnpack": [
      "adapters/**",
      "node_modules/highs/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    },
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "PackRat-${version}-portable-${os}-${arch}.${ext}"
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage"
      ]
    },
    "artifactName": "PackRat-${version}-${os}-${arch}.${ext}"
  }
}
