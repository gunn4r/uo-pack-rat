{
  "$comment": "Pack Rat shard rules file schema v1. Draft-07 style, restricted to the keyword subset app/schema/validate.mts supports. A rules file carries everything that is shard-specific rather than OSI-standard: property caps, the Resisting Spells resist minimum, race-specific cap overrides, tag-penalty units, the rarity ladder (name + colour, in ascending order), the gargoyle race-lock policy the free-skill list shown on character cards and, optionally, the Scroll Binder's recipes (scrollBinder, issue #181) the Slayer filter's grouping (slayerGroups, issue #189) and unraveling's thresholds (unravel, issue #271). app/rules.mts validates every builtin and user rules file against this schema before it reaches setRules().",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "id", "name", "caps", "raceCaps", "tagUnits", "rarity", "raceLock", "freeSkills"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]{1,40}$" },
    "name": { "type": "string", "minLength": 1 },
    "caps": { "type": "object", "additionalProperties": { "type": "number" } },
    "raceCaps": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "type": "number" } } },
    "resistMinimum": {
      "$comment": "Resisting Spells as a floor under every resist. kind servuo: with fixed = the skill x 10, 40 + (fixed - 1000) / 50 from 1000, (fixed - 400) / 15 from 400, none below (ServUO PlayerMobile.GetMinResistance, integer division). A rules file without it gives no minimum.",
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["servuo"] }
      }
    },
    "tagUnits": { "type": "object", "additionalProperties": { "type": "number" } },
    "tagInfo": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 400 } },
    "rarity": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "colour"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "colour": { "type": "string", "minLength": 1 }
        }
      }
    },
    "raceLock": {
      "type": "object",
      "required": ["gargoyleOnly"],
      "properties": {
        "gargoyleOnly": { "type": "boolean" }
      }
    },
    "freeSkills": { "type": "array", "items": { "type": "string" } },
    "slayerGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slayers"],
        "properties": {
          "super": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "heading": { "type": "string", "minLength": 1 },
          "slayers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "scrollBinder": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "powerScrolls": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["from", "to", "count"], "properties": { "from": { "type": "integer", "minimum": 1 }, "to": { "type": "integer", "minimum": 1 }, "count": { "type": "integer", "minimum": 2 } } } },
        "statScrolls": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["from", "to", "count"], "properties": { "from": { "type": "integer", "minimum": 1 }, "to": { "type": "integer", "minimum": 1 }, "count": { "type": "integer", "minimum": 2 } } } },
        "transcendence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["usableAt"],
          "properties": {
            "usableAt": { "type": "array", "minItems": 1, "items": { "type": "number", "minimum": 0.1 } }
          }
        }
      }
    },
    "unravel": {
      "$comment": "Unraveling at a soul forge (issue #271, app/unravel.mts). An item's imbuing weight up to residueMax gives Magical Residue, from relicMin a Relic Fragment, between them Enchanted Essence. Essence needs Imbuing essenceSkill and a Relic relicSkill, else the forge refuses; each roll is a chance from the first number of its range (none) to the second (always), and a miss gives the ingredient below. A weight within maybeMargin of a line could go either way. baseResist is the resist total an armor piece, hat or shield has before any magic, which does not count toward its weight.",
      "type": "object",
      "additionalProperties": false,
      "required": ["residueMax", "relicMin", "essenceSkill", "relicSkill", "residueRoll", "essenceRoll", "relicRoll", "maybeMargin", "baseResist"],
      "properties": {
        "residueMax": { "type": "number", "minimum": 0 },
        "relicMin": { "type": "number", "minimum": 0 },
        "essenceSkill": { "type": "number", "minimum": 0 },
        "relicSkill": { "type": "number", "minimum": 0 },
        "residueRoll": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0 } },
        "essenceRoll": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0 } },
        "relicRoll": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0 } },
        "maybeMargin": { "type": "number", "minimum": 0 },
        "baseResist": {
          "type": "object",
          "additionalProperties": false,
          "required": ["armor", "hat", "shield"],
          "properties": { "armor": { "type": "number", "minimum": 0 }, "hat": { "type": "number", "minimum": 0 }, "shield": { "type": "number", "minimum": 0 } }
        }
      }
    }
  }
}
