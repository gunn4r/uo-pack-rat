{
  "$comment": "Pack Rat shard rules file schema v1. Draft-07 style, restricted to the keyword subset app/schema/validate.mjs supports. A rules file carries everything that is shard-specific rather than OSI-standard: property caps, the Resisting Spells resist-bonus formula, race-specific cap overrides, tag-penalty units, the rarity ladder (name + colour, in ascending order), the gargoyle race-lock policy the free-skill list shown on character cards and, optionally, the Scroll Binder's recipes (scrollBinder, issue #181). app/rules.mjs validates every builtin and user rules file against this schema before it reaches setRules().",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "id", "name", "caps", "raceCaps", "resistSkillBonus", "tagUnits", "rarity", "raceLock", "freeSkills"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]{1,40}$" },
    "name": { "type": "string", "minLength": 1 },
    "caps": { "type": "object", "additionalProperties": { "type": "number" } },
    "raceCaps": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "type": "number" } } },
    "resistSkillBonus": {
      "type": "object",
      "required": ["breakpoints"],
      "properties": {
        "breakpoints": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } } }
      }
    },
    "tagUnits": { "type": "object", "additionalProperties": { "type": "number" } },
    "tagInfo": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 400 } },
    "rarity": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "colour"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "colour": { "type": "string", "minLength": 1 }
        }
      }
    },
    "raceLock": {
      "type": "object",
      "required": ["gargoyleOnly"],
      "properties": {
        "gargoyleOnly": { "type": "boolean" }
      }
    },
    "freeSkills": { "type": "array", "items": { "type": "string" } },
    "scrollBinder": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "powerScrolls": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["from", "to", "count"], "properties": { "from": { "type": "integer", "minimum": 1 }, "to": { "type": "integer", "minimum": 1 }, "count": { "type": "integer", "minimum": 2 } } } },
        "statScrolls": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["from", "to", "count"], "properties": { "from": { "type": "integer", "minimum": 1 }, "to": { "type": "integer", "minimum": 1 }, "count": { "type": "integer", "minimum": 2 } } } },
        "transcendence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["usableAt"],
          "properties": {
            "usableAt": { "type": "array", "minItems": 1, "items": { "type": "number", "minimum": 0.1 } }
          }
        }
      }
    }
  }
}
